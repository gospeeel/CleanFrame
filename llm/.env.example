# CleanFrame LLM service environment example.
# Copy this file to llm/.env for local development.
# In Docker Compose, OLLAMA_BASE_URL is overridden to http://ollama:11434.

# App
APP_ENV=local
APP_VERSION=dev
LLM_PRELOAD_MODEL=true

# RuBERT
RUBERT_MODEL_DIR=trained_model
RUBERT_BATCH_SIZE=16
SCRIPT_PARSER_MAX_ELEMENT_CHARS=900
USE_EXPANDED_LEXICONS=false
HF_RUBERT_REPO_ID=gospeeel/ruBERT-cleanframe
HF_RUBERT_REVISION=main
HF_TOKEN=

# Model registry, optional
MODEL_REGISTRY_PATH=model_registry.json
MODEL_REGISTRY_AUDIT_PATH=reports/model_registry_audit.jsonl

# Qwen/Ollama
LLM_RECOMMENDATIONS_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_RETRY_COUNT=0
OLLAMA_JSON_FORMAT_MODE=schema
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=700
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=6
OLLAMA_NUM_BATCH=128
OLLAMA_NUM_GPU=999
OLLAMA_SEED=
OLLAMA_TOP_K=
OLLAMA_TOP_P=
OLLAMA_OPTIONS_JSON=

# Qwen recommendation generation
# mode: fast, full, grouped
LLM_RECOMMENDATION_MODE=grouped
LLM_RECOMMENDATION_MAX_LLM_ITEMS=0
LLM_RECOMMENDATION_TIME_BUDGET_SECONDS=180
LLM_RECOMMENDATION_TEXT_MAX_CHARS=1200

# Batched mode
LLM_RECOMMENDATION_BATCH_SIZE=6
LLM_RECOMMENDATION_BATCH_TIMEOUT_SECONDS=30
LLM_RECOMMENDATION_BATCH_NUM_PREDICT=220

# Grouped mode
LLM_RECOMMENDATION_GROUP_MAX_ITEMS=6
LLM_RECOMMENDATION_GROUP_MAX_GROUPS=24
LLM_RECOMMENDATION_GROUP_NUM_PREDICT=520
LLM_RECOMMENDATION_GROUP_SUMMARY_ONLY=false
LLM_RECOMMENDATION_GROUP_SUMMARY_NUM_PREDICT=360

# Few-shot recommendation examples, optional
LLM_RECOMMENDATION_EXAMPLES_PATH=datasets/silver/real_text_pseudo/recommendations/train.jsonl
LLM_RECOMMENDATION_EXAMPLES_LIMIT=1
LLM_RECOMMENDATION_EXAMPLES_MAX_ITEMS=24

# Observability, optional
GLITCHTIP_DSN=
GLITCHTIP_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
