# CleanFrame backend environment example.
# Copy this file to backend/.env for local development.
# Docker Compose overrides several connection URLs inside docker-compose.yaml.

# App
PORT=8000
APP_ENV=local
APP_VERSION=dev
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PRIVACY_MODE=false

# Database
DATABASE_URL=postgresql://ml_wink:ml_wink_password@localhost:5432/ml_wink?schema=public
SHADOW_DATABASE_URL=postgresql://ml_wink:ml_wink_password@localhost:5432/ml_wink_shadow?schema=public

# Redis and analysis queue
REDIS_URL=redis://127.0.0.1:6379
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_QUEUE_CONCURRENCY=1
ANALYSIS_QUEUE_ATTEMPTS=2
ANALYSIS_OPS_PROBLEM_WINDOW_HOURS=24

# LLM service
LLM_SERVICE_URL=http://127.0.0.1:8001
LLM_ANALYSIS_TIMEOUT_MS=600000

# Analysis file storage and retention
ANALYSIS_UPLOAD_DIR=uploads/analysis
ANALYSIS_RETENTION_CLEANUP_ENABLED=true
ANALYSIS_RETENTION_CLEANUP_INTERVAL_MS=3600000
ANALYSIS_FAILED_FILE_RETENTION_DAYS=7

# Long-running analysis notifications
ANALYSIS_LONG_RUNNING_NOTIFICATIONS_ENABLED=true
ANALYSIS_LONG_RUNNING_CHECK_INTERVAL_MS=60000
ANALYSIS_LONG_RUNNING_THRESHOLD_MS=600000

# Auth
JWT_ACCESS_SECRET=replace-with-long-random-access-secret

# Initial super admin seed
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# OAuth providers, optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Avatar/object storage, optional
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Observability, optional
GLITCHTIP_DSN=
GLITCHTIP_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
